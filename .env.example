NODE_ENV=development
HOST=127.0.0.1
PORT=8787

# Public app URL. Use your HTTPS domain in production.
NOVAX_PUBLIC_ORIGIN=http://127.0.0.1:8787

# SQLite storage for Beta. Use a persistent disk on your hosting provider.
NOVAX_DATA_DIR=./data
# NOVAX_DATABASE_PATH=./data/novax.sqlite

# Optional PostgreSQL storage for free Render + Neon deployments.
# If DATABASE_URL is set, NovaX uses PostgreSQL instead of SQLite.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

NOVAX_SESSION_DAYS=14
NOVAX_MAX_JSON_BYTES=1000000
NOVAX_PASSWORD_RESET_MINUTES=30

# Optional admin token for Beta back office panels.
# Set this only in your hosting provider environment variables. Sign in, open
# profile settings, and enter this token once to promote that account to admin.
# NOVAX_ADMIN_TOKEN=change-this-to-a-long-random-secret

# Optional email delivery for password reset links. Resend and SMTP are supported.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx
# SMTP_HOST=smtp.your-mail-provider.example
# SMTP_PORT=587
# SMTP_USER=your-account@example.com
# SMTP_PASS=your-smtp-password
# SMTP_SECURE=false
# SMTP_HELO_NAME=novax.local
# NOVAX_EMAIL_FROM=NovaX <noreply@your-domain.example>
# NOVAX_SUPPORT_EMAIL=support@your-domain.example

# Only needed when frontend and API are hosted on different origins.
NOVAX_CORS_ORIGINS=http://127.0.0.1:8787
